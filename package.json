{
  "name": "template-vike-lite-vue-daisyui-hono",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vite dev",
    "type:check": "tsc",
    "build": "yarn build:client && yarn build:server",
    "build:docker": "yarn build:client && yarn build:server:docker",
    "build:client": "vite build",
    "build:server": "vite build --ssr",
    "build:server:docker": "IS_DOCKER=true vite build --ssr",
    "prod": "NODE_ENV=production node dist/server/index.mjs",
    "preview": "NODE_ENV=production node scripts/startServerPreview.mjs",
    "lint": "eslint src/**/*.{ts,tsx} *.ts",
    "od": "yarn outdated"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@yarnpkg/sdks": "^3.3.1",
    "daisyui": "^5.7.9",
    "eslint": "^10.8.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "hono": "^4.12.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vike-lite": "^1.21.5",
    "vike-lite-vue": "^1.2.3",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "files": [
    "dist"
  ]
}
